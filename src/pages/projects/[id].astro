---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectContent from '../../components/ProjectContent.astro';
import { projectType } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, tagline, summary, impact } = project.data;
const description = [impact, tagline, summary].filter(Boolean).join(' - ').slice(0, 200);
---

<Base title={title} description={description}>
  <nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-5 pt-8 sm:px-8">
    <ol class="label flex flex-wrap items-center gap-2 text-ink-soft">
      <li><a href="/" class="font-bold text-accent underline decoration-2 underline-offset-4">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/projects" class="font-bold text-accent underline decoration-2 underline-offset-4">Projects</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-ink">{title}</li>
    </ol>
    <p class="mt-2 text-sm font-semibold text-ink-soft">{projectType(project)}</p>
  </nav>

  <ProjectContent project={project}>
    <Content />
  </ProjectContent>

  <div class="mx-auto max-w-6xl px-5 pb-16 sm:px-8">
    <a href="/projects" class="press inline-flex items-center gap-2 border-[3px] border-ink bg-paper px-5 py-3 font-bold">
      <span aria-hidden="true">←</span> All projects
    </a>
  </div>
</Base>
