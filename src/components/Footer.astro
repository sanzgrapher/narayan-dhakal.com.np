---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="border-t-[3px] border-ink">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <p class="label">© {year} {profile.name}</p>
    <ul class="flex gap-5">
      <li><a class="label underline-offset-4 hover:text-accent hover:underline" href={profile.links.github} rel="me">GitHub</a></li>
      <li><a class="label underline-offset-4 hover:text-accent hover:underline" href={profile.links.linkedin} rel="me">LinkedIn</a></li>
      <li><a class="label underline-offset-4 hover:text-accent hover:underline" href={`mailto:${profile.email}`}>Email</a></li>
    </ul>
  </div>
</footer>
