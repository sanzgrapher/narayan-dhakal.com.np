---
interface Props {
  title: string;
  id: string;
  level?: 1 | 2;
}
const { title, id, level = 2 } = Astro.props;
const Tag = level === 1 ? 'h1' : 'h2';
---

<div class="mb-8 flex flex-wrap items-end justify-between gap-x-8 gap-y-2 border-b-[3px] border-ink pb-4">
  <Tag id={id} class="text-(length:--text-section) leading-none font-black tracking-tight uppercase sm:font-wide">
    {title}
  </Tag>
  {
    Astro.slots.has('default') && (
      <p class="max-w-[40ch] font-semibold text-ink-soft">
        <slot />
      </p>
    )
  }
</div>
