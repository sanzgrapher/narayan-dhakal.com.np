---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 4);

const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: '2-digit' });
---

{
  posts.length > 0 && (
    <section id="writing" aria-labelledby="writing-title" class="mx-auto max-w-6xl px-5 py-16 sm:px-8 md:py-20">
      <SectionHeading id="writing-title" title="Writing">
        Notes from building and shipping.
      </SectionHeading>
      <ul class="border-t-2 border-ink">
        {posts.map((post) => (
          <li class="border-b-2 border-ink">
            <a
              href={`/blog/${post.id}`}
              class="group -mx-2 grid gap-1 px-2 py-4 transition-colors hover:bg-ink hover:text-paper md:grid-cols-[9rem_1fr_auto] md:items-baseline md:gap-6"
            >
              <time class="label text-ink-soft group-hover:text-paper/75" datetime={post.data.published.toISOString()}>
                {fmt.format(post.data.published)}
              </time>
              <span class="text-lg font-extrabold">{post.data.title}</span>
              <span aria-hidden="true" class="hidden group-hover:text-accent md:inline">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
