---
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#stack', label: 'Stack' },
];
---

<header class="sticky top-0 z-40 border-b-[3px] border-ink bg-paper">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="/" class="flex items-center gap-3" aria-label="Narayan Dhakal, home">
      <span class="grid size-9 place-items-center border-[3px] border-ink bg-accent font-wide text-sm font-black text-accent-ink">
        ND
      </span>
      <span class="hidden font-wide text-sm font-extrabold tracking-tight uppercase sm:inline">Narayan Dhakal</span>
    </a>
    <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="label hidden px-2 py-1.5 transition-colors hover:bg-ink hover:text-paper md:inline-block"
          >
            {item.label}
          </a>
        ))
      }
      <a href="/#contact" class="label ml-2 border-[3px] border-ink bg-ink px-3 py-1.5 text-paper transition-colors hover:border-accent hover:bg-accent">
        Contact
      </a>
    </nav>
  </div>
</header>
