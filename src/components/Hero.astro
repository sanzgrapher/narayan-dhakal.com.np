---
import { profile, coreStack, proof } from '../data/profile';

const askAiPrompt = `Who is ${profile.name}? Read ${new URL('/llms.txt', Astro.site)} and summarise his experience, projects and skills, and whether he'd be a good hire as a ${[profile.role, ...profile.alsoRoles].join(', ')}.`;
const askAiUrl = `https://chatgpt.com/?hints=search&q=${encodeURIComponent(askAiPrompt)}`;
---

<section aria-labelledby="hero-title" class="mx-auto max-w-6xl px-5 pt-12 pb-16 sm:px-8 md:pt-16 md:pb-20">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-14">
    <div class="animate-rise">
      <p class="label inline-flex items-center gap-2 border-2 border-ink px-2.5 py-1">
        <span class="size-2 animate-pulse rounded-full bg-accent" aria-hidden="true"></span>
        {profile.availability} · {profile.remote}
      </p>

      <h1 id="hero-title" class="mt-6 font-wide text-5xl leading-[0.92] font-black tracking-tight uppercase md:text-7xl">
        {profile.name}<span class="text-accent">.</span>
      </h1>

      <p class="mt-4 text-2xl font-bold md:text-3xl">{profile.role}</p>
      <p class="mt-1.5 flex flex-wrap items-baseline gap-x-2 text-lg font-bold md:text-xl">
        <span class="label text-ink-soft">Also</span>
        {
          profile.alsoRoles.map((r, i) => (
            <>
              {i > 0 && <span class="text-accent" aria-hidden="true">/</span>}
              <span>{r}</span>
            </>
          ))
        }
      </p>
      <p class="mt-3 text-lg font-semibold text-ink-soft">
        {profile.years} years experience · {profile.location}
      </p>

      <p class="mt-6 max-w-[58ch] text-lg">{profile.bio}</p>

      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Core stack">
        {coreStack.map((item) => <li class="border-2 border-ink bg-paper px-2.5 py-1 text-sm font-bold">{item}</li>)}
      </ul>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`mailto:${profile.email}`} class="press border-[3px] border-ink bg-accent px-5 py-3 font-bold text-accent-ink">
          Email me
        </a>
        <a href={profile.links.linkedin} rel="me" class="press border-[3px] border-ink bg-paper px-5 py-3 font-bold">LinkedIn</a>
        <a href={profile.links.github} rel="me" class="press border-[3px] border-ink bg-paper px-5 py-3 font-bold">GitHub</a>
      </div>
    </div>

    <div class="animate-rise grid gap-4 self-start [animation-delay:120ms]">
      <proof-card class="block border-[3px] border-ink bg-paper shadow-hard" aria-labelledby="proof-title">
        <div class="flex items-stretch border-b-[3px] border-ink bg-ink">
          <h2 id="proof-title" data-title class="label flex-1 px-4 py-2.5 text-paper">Track record</h2>
          <button
            type="button"
            data-photo-toggle
            class="press flex size-[2.625rem] shrink-0 items-center justify-center border-l-[3px] border-ink text-paper hover:bg-accent hover:text-accent-ink"
            aria-label="Show photo"
            aria-pressed="false"
            aria-controls="proof-photo"
          >
            <svg data-icon-camera xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" class="size-4" aria-hidden="true">
              <path d="M4 8h3l2-2h6l2 2h3v11H4z" />
              <circle cx="12" cy="13" r="3.25" />
            </svg>
            <svg data-icon-close hidden xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" class="size-4" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </div>
        {/* Proof keeps layout height; photo overlays the same box so size never jumps.
            min-h gives the portrait a bit more room than the bare stats list. */}
        <div class="relative min-h-[22rem]">
          <dl data-proof class="flex h-full min-h-[22rem] flex-col">
            <div class="flex flex-1 flex-col justify-center">
              {
                proof.map((item, i) => (
                  <div class:list={['grid grid-cols-[7.5rem_1fr] items-baseline gap-3 px-4 py-3.5', i > 0 && 'border-t-2 border-ink']}>
                    <dt class="font-wide text-xl font-black">{item.value}</dt>
                    <dd class="text-sm font-semibold leading-snug text-ink-soft">{item.label}</dd>
                  </div>
                ))
              }
            </div>
            <div class="border-t-2 border-ink px-4 py-2.5">
              <p class="label text-center text-ink-soft">Design · develop · maintain · scale</p>
            </div>
          </dl>
          <div id="proof-photo" data-photo hidden class="absolute inset-0 bg-paper-deep">
            <img
              src={profile.avatar}
              alt={profile.name}
              width="460"
              height="460"
              class="size-full object-cover object-[center_20%]"
              loading="lazy"
            />
          </div>
        </div>
      </proof-card>
      <a
        href={askAiUrl}
        target="_blank"
        rel="noopener"
        class="press flex items-center justify-between gap-3 border-[3px] border-ink bg-ink px-4 py-3 font-bold text-paper"
      >
        <span>Ask ChatGPT about me</span>
        <span aria-hidden="true">↗</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </div>
  </div>
</section>

<script>
  class ProofCard extends HTMLElement {
    connectedCallback() {
      const btn = this.querySelector<HTMLButtonElement>('[data-photo-toggle]');
      const title = this.querySelector<HTMLElement>('[data-title]');
      const proof = this.querySelector<HTMLElement>('[data-proof]');
      const photo = this.querySelector<HTMLElement>('[data-photo]');
      const cam = this.querySelector<HTMLElement>('[data-icon-camera]');
      const close = this.querySelector<HTMLElement>('[data-icon-close]');
      if (!btn || !title || !proof || !photo || !cam || !close) return;

      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-pressed') !== 'true';
        btn.setAttribute('aria-pressed', String(open));
        btn.setAttribute('aria-label', open ? 'Hide photo' : 'Show photo');
        title.textContent = open ? 'Photo' : 'Track record';
        // Keep proof in flow (invisible) so the card height stays fixed.
        proof.classList.toggle('invisible', open);
        photo.hidden = !open;
        cam.hidden = open;
        close.hidden = !open;
      });
    }
  }

  if (!customElements.get('proof-card')) {
    customElements.define('proof-card', ProofCard);
  }
</script>
