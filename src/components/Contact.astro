---
import { profile } from '../data/profile';
---

<section id="contact" aria-labelledby="contact-title" class="border-t-[3px] border-ink bg-ink text-paper">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 sm:px-8 md:py-28 lg:grid-cols-[1fr_auto] lg:items-end">
    <div>
      <p class="label text-accent">{profile.availability} · {profile.location} · {profile.remote}</p>
      <h2 id="contact-title" class="mt-4 text-(length:--text-section) sm:font-wide leading-[0.95] font-black tracking-tight uppercase">
        Got something<br />to build?
      </h2>
      <p class="mt-5 max-w-[48ch] text-lg text-paper/75">
        Freelance, contract or full-time. Email is the fastest way to reach me.
      </p>
    </div>
    <a
      href={`mailto:${profile.email}`}
      class="group inline-flex max-w-full items-center gap-4 border-[3px] border-paper bg-accent px-5 py-4 text-base font-extrabold break-all sm:px-6 sm:py-5 sm:font-wide sm:text-lg text-accent-ink shadow-[6px_6px_0_0_var(--color-paper)] transition-transform duration-150 hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-1 active:translate-y-1 active:shadow-none md:text-xl"
    >
      {profile.email}
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
    </a>
  </div>
</section>
