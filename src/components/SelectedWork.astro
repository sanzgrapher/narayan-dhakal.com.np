---
import SectionHeading from './SectionHeading.astro';
import Tags from './Tags.astro';
import Platforms from './Platforms.astro';
import { projectUrl, projectType, type Project } from '../lib/projects';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
---

<section id="work" aria-labelledby="work-title" class="border-y-[3px] border-ink bg-paper-deep">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 md:py-20">
    <SectionHeading id="work-title" title="Work" />

    <ul class="grid gap-5">
      {
        projects.map((p) => (
          <li>
            <a
              href={projectUrl(p)}
              class="press group grid gap-x-8 gap-y-3 border-[3px] border-ink bg-paper p-5 md:grid-cols-[11rem_minmax(0,1fr)_auto] md:items-center md:p-6"
            >
              <p class="font-wide text-xl leading-tight font-black text-accent md:text-2xl">{p.data.impact ?? projectType(p)}</p>
              <div>
                <p class="label flex flex-wrap items-center gap-x-2 gap-y-1 text-ink-soft">
                  {p.data.badge && <span class="bg-ink px-1.5 py-0.5 text-paper">{p.data.badge}</span>}
                  {p.data.links.live && (
                    <span class="inline-flex items-center gap-1 text-accent">
                      <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
                      Live
                    </span>
                  )}
                  <span>
                    {projectType(p)}
                    {p.data.org && ` · ${p.data.org}`} · {p.data.period}
                  </span>
                </p>
                <h3 class="mt-1 text-2xl leading-tight font-extrabold tracking-tight">{p.data.title}</h3>
                {p.data.tagline && <p class="text-lg font-semibold text-ink/75">{p.data.tagline}</p>}
                <p class="mt-1.5 max-w-[68ch] text-ink-soft">{p.data.summary}</p>
                {p.data.highlights.length > 0 && (
                  <ul
                    class="mt-4 grid divide-y-2 divide-ink border-2 border-ink sm:grid-cols-(--cols) sm:divide-x-2 sm:divide-y-0"
                    style={`--cols: repeat(${p.data.highlights.length}, minmax(0, 1fr))`}
                    aria-label="Highlights"
                  >
                    {p.data.highlights.map((part) => (
                      <li class="px-3 py-2">
                        <span class="block text-sm font-extrabold">{part.name}</span>
                        {part.name === 'Platforms' && p.data.platforms.length > 0 ? (
                          <Platforms items={p.data.platforms} inline />
                        ) : (
                          part.detail && <span class="block text-xs font-semibold text-ink-soft">{part.detail}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
                <div class="mt-3">
                  <Tags items={p.data.stack} limit={5} />
                </div>
              </div>
              <span class="label inline-flex items-center gap-1 whitespace-nowrap group-hover:text-accent">
                Case study <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
